{
  "name": "medilink-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MediLink API \u2014 Express + Prisma (MySQL), NestJS-style module layout",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/main.js",
    "start": "node --env-file=.env src/main.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file=.env prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script -o ../database/schema.sql",
    "test": "node --env-file=.env --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "prisma": {
    "seed": "node --env-file=.env prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
