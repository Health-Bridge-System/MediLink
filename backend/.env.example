# Copy to .env and adjust. Never commit the real .env.
PORT=4000
DATABASE_URL="mysql://medilink:medilink_dev@localhost:3307/medilink"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:5173"
# Python CDSS service (FastAPI). Leave empty to use the built-in demo stub.
CDSS_URL=""
# Enables one-click demo logins on the login page. Set to false outside the demo.
DEMO_MODE=true
